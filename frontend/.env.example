# 前端演示账号预填（可选）
#
# 复制为 .env.local 并填写后，`npm run dev` 会在登录页预填账号口令，方便课程答辩。
# 不要提交 .env.local（已被 .gitignore 忽略）；生产构建请不要设置这几项。
#
# 学生端登录页（src/views/student/Login.vue）
VITE_DEMO_STUDENT_EMAIL=
VITE_DEMO_STUDENT_PASSWORD=
#
# 管理端登录页（src/views/admin/AdminLogin.vue）
VITE_DEMO_ADMIN_NO=
VITE_DEMO_ADMIN_PASSWORD=

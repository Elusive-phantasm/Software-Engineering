        </mxCell>
        <mxCell id="s_draft" value="&lt;b&gt;未提交&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7280&quot;&gt;可浏览 · 不可交易&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#C79A2E;strokeWidth=2.5;fontSize=15;fontColor=#17202A;" vertex="1" parent="1">

        </mxCell>
        <mxCell id="s_review" value="&lt;b&gt;待审核&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7280&quot;&gt;等待管理员核验&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#3F73D8;strokeWidth=2.5;fontSize=15;fontColor=#17202A;" vertex="1" parent="1">

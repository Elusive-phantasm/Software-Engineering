<mxfile host="app.diagrams.net" type="device">
  <diagram id="sm04" name="SM-04 学生认证状态机">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="SM-04　学生认证状态机" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=24;fontColor=#111827;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="20.0" width="900.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="sub1" value="建模对象：学生的认证状态（非订单、非商品）　｜　转换编号 AT-01～AT-08" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1">
          <mxGeometry x="42.0" y="66.0" width="980.0" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="sub2" value="认证状态与订单／商品／物品流转三套状态机完全独立：任一认证转换都不改变商品状态、订单状态与信用分（BR-27）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#B45309;" vertex="1" parent="1">
          <mxGeometry x="42.0" y="98.0" width="1160.0" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="实线箭头 = 状态发生变化的转换　｜　虚线自环 = 状态保持（AT-06、AT-07），不绘制为成功转换&lt;br&gt;「受限 / 封禁」属账号状态，不在本状态机内：认证通过不等于解封，封禁也不撤销认证" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#4B5563;" vertex="1" parent="1">
          <mxGeometry x="42.0" y="825.0" width="1120.0" height="56.0" as="geometry" />
        </mxCell>

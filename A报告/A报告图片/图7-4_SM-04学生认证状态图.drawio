        <mxCell id="s_ok" value="&lt;b&gt;已认证&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7280&quot;&gt;可发布 · 可下单&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F5EC;strokeColor=#2F8F55;strokeWidth=2.5;fontSize=15;fontColor=#17202A;" vertex="1" parent="1">

/></mxCell><mxCell id="e8" value="会话签发与吊销" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#25835B;fontColor=#25835B;fontSize=13;" edge="1" parent="1" source="tokenService" target="sessionMapper"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="开关检查" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B66A00;fontColor=#B66A00;fontSize=13;" edge="1" parent="1" source="devController" target="devService"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="authController" value="&lt;div style=&quot;font-size:18px;font-weight:bold&quot;&gt;AuthController&lt;/div&gt;&lt;div style=&quot;font-size:14px;margin-top:8px&quot;&gt;登录 · 注册 · 重置密码&lt;br&gt;管理员改密 · 个人资料&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2FF;strokeColor=#2864B4;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;spacingTop=10;fontColor=#223044;" vertex="1" parent="1"><mxGeometry x="70" y="200" width="320" height="150" as="geometry" /></mxCell><mxCell id="writeControllers" value="&lt;div style=&quot;font-size:18px;font-weight:bold&quot;&gt;学生写操作控制器&lt;/div&gt;&lt;div style=&quot;font-size:14px;margin-top:8px&quot;&gt;发布、下单、评价、举报&lt;br&gt;写操作委托业务服务&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2FF;strokeColor=#2864B4;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;spacingTop=10;fontColor=#223044;" vertex="1" parent="1"><mxGeometry x="70" y="430" width="320" height="155" as="geometry" /></mxCell><mxCell id="devController" value="&lt;div style=&quot;font-size:18px;font-weight:bold&quot;&gt;DevController&lt;/div&gt;&lt;div style=&quot;font-size:14px;margin-top:8px&quot;&gt;全部路由先检查&lt;br&gt;enable-dev-tools 开关&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF4E5;strokeColor=#B66A00;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;spacingTop=10;fontColor=#223044;" vertex="1" parent="1"><mxGeometry x="70" y="675" width="320" height="135" as="geometry" /></mxCell><mxCell id="authService" value="&lt;div style=&quot;font-size:18px;font-weight:bold&quot;&gt;AuthService&lt;/div&gt;&lt;div style=&quot;font-size:14px;margin-top:8px&quot;&gt;学生登录 · 密码重置 · 管理员改密&lt;br&gt;失败计数委托 LoginFailureService&lt;br&gt;验证码校验委托 EmailCodeService&lt;br&gt;改密成功吊销管理员全部会话&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF8F1;strokeColor=#25835B;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;spacingTop=10;fontColor=#223044;" vertex="1" parent="1"><mxGeometry x="500" y="195" width="470" height="220" as="geometry" /></mxCell><mxCell id="permission" value="&lt;div style=&quot;font-size:18px;font-weight:bold&quot;&gt;PermissionService&lt;/div&gt;&lt;div style=&quot;font-size:14px;margin-top:8px&quot;&gt;发布 / 下单 / 评价 / 举报资格守卫&lt;br&gt;认证状态 · 封禁状态 · 信用阈值&lt;br&gt;按身份及操作选择拒绝提示&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF8F1;strokeColor=#25835B;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;spacingTop=10;fontColor=#223044;" vertex="1" parent="1"><mxGeometry x="500" y="495" width="470" height="180" as="geometry" /></mxCell><mxCell id="emailService" value="&lt;div style=&quot;font-size:18px;font-weight:bold&quot;&gt;EmailCodeService&lt;/div&gt;&lt;div style=&quot;font-size:14px;margin-top:8px&quot;&gt;验证码摘要与有效期校验&lt;br&gt;now &amp;gt;= expiresAt 时失效&lt;br&gt;错误时委托独立计数服务&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF8F1;strokeColor=#25835B;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;spacingTop=10;fontColor=#223044;" vertex="1" parent="1"><mxGeometry x="500" y="755" width="470" height="155" as="geometry" /></mxCell><mxCell id="tokenService" value="&lt;div style=&quot;font-size:18px;font-weight:bold&quot;&gt;TokenService&lt;/div&gt;&lt;div style=&quot;font-size:14px;margin-top:8px&quot;&gt;创建、单个撤销、按主体吊销会话&lt;br&gt;管理员改密后旧令牌立即失效&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF8F1;strokeColor=#25835B;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;spacingTop=10;fontColor=#223044;" vertex="1" parent="1"><mxGeometry x="500" y="990" width="470" height="130" as="geometry" /></mxCell><mxCell id="loginFailure" value="&lt;div style=&quot;font-size:18px;font-weight:bold&quot;&gt;LoginFailureService&lt;/div&gt;&lt;div style=&quot;font-size:14px;margin-top:8px&quot;&gt;@Transactional(REQUIRES_NEW)&lt;br&gt;按学生账号行锁累计登录失败&lt;br&gt;第 5 次失败建立 15 分钟锁定&lt;br&gt;锁定期间不延长 lockedUntil&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3EDFF;strokeColor=#7446A8;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;spacingTop=10;fontColor=#223044;" vertex="1" parent="1"><mxGeometry x="1080" y="205" width="560" height="205" as="geometry" /></mxCell><mxCell id="emailFailure" value="&lt;div style=&quot;font-size:18px;font-weight:bold&quot;&gt;EmailCodeFailureService&lt;/div&gt;&lt;div style=&quot;font-size:14px;margin-top:8px&quot;&gt;@Transactional(REQUIRES_NEW)&lt;br&gt;按验证码记录行锁累计错误次数&lt;br&gt;第 5 次错误将记录作废&lt;br&gt;外层认证异常不会回滚该更新&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3EDFF;strokeColor=#7446A8;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;spacingTop=10;fontColor=#223044;" vertex="1" parent="1"><mxGeometry x="1080" y="490" width="560" height="205" as="geometry" /></mxCell><mxCell id="devService" value="&lt;div style=&quot;font-size:18px;font-weight:bold&quot;&gt;DevService&lt;/div&gt;&lt;div style=&quot;font-size:14px;margin-top:8px&quot;&gt;配置关闭时拒绝所有 /api/dev/**&lt;br&gt;生产 application-prod.yml = false&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF4E5;strokeColor=#B66A00;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;spacingTop=10;fontColor=#223044;" vertex="1" parent="1"><mxGeometry x="1080" y="770" width="560" height="145" as="geometry" /></mxCell><mxCell id="studentMapper" value="&lt;div style=&quot;font-size:18px;font-weight:bold&quot;&gt;StudentMapper&lt;/div&gt;&lt;div style=&quot;font-size:14px;margin-top:8px&quot;&gt;学生账号 · failedLoginCount&lt;br&gt;lockedUntil&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F5F7FA;strokeColor=#637083;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;spacingTop=10;fontColor=#223044;" vertex="1" parent="1"><mxGeometry x="70" y="1160" width="380" height="135" as="geometry" /></mxCell><mxCell id="emailMapper" value="&lt;div style=&quot;font-size:18px;font-weight:bold&quot;&gt;EmailCodeMapper&lt;/div&gt;&lt;div style=&quot;font-size:14px;margin-top:8px&quot;&gt;验证码 · failCount · used&lt;br&gt;过期时间与验证码摘要&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F5F7FA;strokeColor=#637083;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;spacingTop=10;fontColor=#223044;" vertex="1" parent="1"><mxGeometry x="670" y="1160" width="380" height="135" as="geometry" /></mxCell><mxCell id="sessionMapper" value="&lt;div style=&quot;font-size:18px;font-weight:bold&quot;&gt;LoginSessionMapper&lt;/div&gt;&lt;div style=&quot;font-size:14px;margin-top:8px&quot;&gt;会话摘要 · subject · revoked&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F5F7FA;strokeColor=#637083;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;spacingTop=10;fontColor=#223044;" vertex="1" parent="1"><mxGeometry x="1270" y="1160" width="370" height="135" as="geometry" /></mxCell><mxCell id="heading" value="后端服务结构 UML｜认证、权限与独立事务" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#1E2D42;" vertex="1" parent="1"><mxGeometry x="55" y="35" width="1500" height="65" as="geometry" /></mxCell><mxCell id="note" value="图中聚焦实现结构。REQUIRES_NEW 由独立 Spring Service 代理调用，失败计数在认证失败异常回滚后仍保留。原始需求概念类图未改动。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E8;strokeColor=#E9D99F;fontSize=15;fontColor=#6E5A22;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="55" y="1310" width="1610" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
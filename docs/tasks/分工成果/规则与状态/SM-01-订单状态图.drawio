<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram name="SM-01-订单状态图" id="SM-01">
    <mxGraphModel page="1" pageWidth="1800" pageHeight="900">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="SM-01-订单状态图（UML 状态机图）" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=34;fontFamily=Microsoft YaHei;">
          <mxGeometry as="geometry" x="60" y="35" width="1680" height="50" />
        </mxCell>
        <mxCell id="subtitle" value="V2.1 · 成交 · 仅记录有效、已撤销；平台不记录支付、交付或退款状态" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontFamily=Microsoft YaHei;">
          <mxGeometry as="geometry" x="60" y="90" width="1680" height="45" />
        </mxCell>
        <mxCell id="s" value="" style="ellipse;fillColor=#182d37;strokeColor=#182d37;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="300" width="22" height="22" />
        </mxCell>
        <mxCell id="a" value="有效" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=26;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="240" y="276" width="180" height="70" />
        </mxCell>
        <mxCell id="b" value="已撤销" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=26;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700" y="276" width="180" height="70" />
        </mxCell>
        <mxCell id="edge0" source="s" target="a" parent="1" edge="1" style="edgeStyle=none;rounded=0;endArrow=open;endFill=0;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;strokeColor=#435962;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge1" source="a" target="b" parent="1" edge="1" style="edgeStyle=none;rounded=0;endArrow=open;endFill=0;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;strokeColor=#435962;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="label0" value="下单成功 [商品为在售且满足下单规则] / 创建唯一成交" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontFamily=Microsoft YaHei;">
          <mxGeometry as="geometry" x="75" y="220" width="460" height="100" />
        </mxCell>
        <mxCell id="label1" value="双方审批同意撤销 [申请方不能审批自己] / 恢复商品可交易状态" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontFamily=Microsoft YaHei;">
          <mxGeometry as="geometry" x="440" y="150" width="460" height="100" />
        </mxCell>
        <mxCell id="note0" value="成交创建与商品状态更新在同一事务内完成；同一商品最多一笔有效成交。" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontFamily=Microsoft YaHei;">
          <mxGeometry as="geometry" x="60" y="729" width="1680" height="36" />
        </mxCell>
        <mxCell id="note1" value="撤销申请先记录申请并保持有效；对方同意后才进入已撤销。" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontFamily=Microsoft YaHei;">
          <mxGeometry as="geometry" x="60" y="767" width="1680" height="36" />
        </mxCell>
        <mxCell id="final_b" value="" vertex="1" parent="1" style="ellipse;fillColor=#ffffff;strokeColor=#000000;">
          <mxGeometry as="geometry" x="775.0" y="386" width="30" height="30" />
        </mxCell>
        <mxCell id="inner_b" value="" vertex="1" parent="final_b" style="ellipse;fillColor=#000000;strokeColor=#000000;">
          <mxGeometry as="geometry" x="6" y="6" width="18" height="18" />
        </mxCell>
        <mxCell id="end_b" source="b" target="final_b" edge="1" parent="1" style="endArrow=open;endFill=0;strokeColor=#000000;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="legend" value="UML：实心圆 = 初始伪状态；靶心圆 = 终止状态；转换 = 事件 [守卫条件] / 效果。" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=17;fontFamily=Microsoft YaHei;">
          <mxGeometry as="geometry" x="60" y="840" width="1480" height="35" />
        </mxCell>
      </root>
    </mxGraphModel>

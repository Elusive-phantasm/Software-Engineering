        <mxCell id="label0" value="创建商品 [身份、信用与账号状态符合要求]" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontFamily=Microsoft YaHei;">

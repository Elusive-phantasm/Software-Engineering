        </mxCell>
        <mxCell id="label2" value="下单成功 [商品仍为在售] / 创建有效成交" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontFamily=Microsoft YaHei;">

        </mxCell>
        <mxCell id="note0" value="商品下单成功后直接进入已售出，成交状态为有效。" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontFamily=Microsoft YaHei;">

        <mxCell id="label1" value="管理员审核通过 [内容合规] / 记录审核结果" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontFamily=Microsoft YaHei;">

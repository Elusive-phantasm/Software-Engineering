        <mxCell id="label3" value="审核拒绝或管理员下架 [理由完整]" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontFamily=Microsoft YaHei;">

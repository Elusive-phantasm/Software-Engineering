          <mxGeometry as="geometry" x="115" y="500" width="460" height="100" />
        </mxCell>
        <mxCell id="note0" value="ST-22 卖家主动下架；ST-23 管理员违规处置；ST-36 卖家撤回待审；ST-37 与基于该商品的捐赠／回收申请同事务成功。" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontFamily=Microsoft YaHei;">

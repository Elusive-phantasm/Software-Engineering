          <mxGeometry as="geometry" x="600" y="1590" width="480" height="75" />
        </mxCell>
        <mxCell id="note0" value="捐赠链：待入库 → 待领取 → 已预约 → 已转交；FT-14 管理员确认入库，FT-15 未取件或损坏时回到待领取。" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontFamily=Microsoft YaHei;">
          <mxGeometry as="geometry" x="60" y="1965" width="1680" height="36" />
        </mxCell>
        <mxCell id="note1" value="借用链：申请中 → 借用中 → 逾期 → 已归还；双方确认按 FT-08，FT-16 在一方标记归还满 7 天后自动确认。" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontFamily=Microsoft YaHei;">
          <mxGeometry as="geometry" x="60" y="2003" width="1680" height="36" />
        </mxCell>
        <mxCell id="note2" value="回收链：申请中 → 已受理 → 已完成；拒收、超时、交接失败或主动取消 → 已取消。" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontFamily=Microsoft YaHei;">
          <mxGeometry as="geometry" x="60" y="2041" width="1680" height="36" />
        </mxCell>
        <mxCell id="note3" value="捐赠、借用和回收的同名状态按记录类型区分，不互相转换，也不占用商品五状态。" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontFamily=Microsoft YaHei;">
          <mxGeometry as="geometry" x="60" y="2079" width="1680" height="36" />
        </mxCell>
        <mxCell id="note4" value="ST-37 与基于原在售商品的 FT-01／FT-10 同事务；流转取消后商品仍为已下架，须重新提交审核。" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontFamily=Microsoft YaHei;">
          <mxGeometry as="geometry" x="60" y="2117" width="1680" height="36" />
        </mxCell>

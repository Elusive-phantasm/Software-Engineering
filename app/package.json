{
  "name": "campus-reuse-platform",
  "version": "2.1.1",
  "private": true,
  "description": "拾光二手 · 校园二手交易平台（依据《需求规格说明书 V2.1》实现）",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --no-warnings src/server.js",
    "dev": "node --no-warnings --watch src/server.js",
    "seed": "node --no-warnings src/seed/seed.js --reset",
    "seed:keep": "node --no-warnings src/seed/seed.js",
    "test": "node --no-warnings tests/run-all.js",
    "test:smoke": "node --no-warnings tests/smoke.js",
    "test:uc": "node --no-warnings tests/uc/run-uc.js",
    "test:sc": "node --no-warnings tests/sc/run-sc.js",
    "test:ui": "node --no-warnings tests/ui/run-ui.js",
    "mail:setup": "node --no-warnings scripts/mail-setup.js",
    "mail:test": "node --no-warnings scripts/mail-test.js",
    "docs:word": "python scripts/md2docx.py"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "jsdom": "^31.0.0"
  }
}

# 后端环境变量示例（复制为部署环境变量即可，不要提交真实值）
#
# 课程演示/本机开发：全部留空也能启动（application.yml 提供演示默认值）。
# 正式部署：至少设置 APP_ENV=prod、DB_PASSWORD、APP_SEED_ENABLED=false，并按启动校验报错逐项修正。

# 运行环境标识：dev（演示/开发） / prod（正式部署，启动时校验并拒绝不安全组合）
APP_ENV=dev

# 数据库连接
DB_PORT=3306
DB_NAME=campus_trade
DB_USERNAME=campus
DB_PASSWORD=

# 演示工具与接口文档开关（正式部署都应为 false）
APP_ENABLE_DEV_TOOLS=false
APP_ENABLE_API_DOCS=true

# 演示数据初始化（正式部署应为 false）
APP_SEED_ENABLED=true
APP_SEED_ADMIN_NO=ADM-001
# 留空则首次启动随机生成并写入 APP_SEED_CREDENTIALS_FILE
APP_SEED_ADMIN_PASSWORD=
APP_SEED_DEMO_PASSWORD=
# 是否强制管理员首次登录改密（对齐 SRS UC-04；演示默认 false）
APP_SEED_ADMIN_MUST_CHANGE=false
APP_SEED_CREDENTIALS_FILE=./data/seed-credentials.txt
